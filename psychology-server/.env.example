# 应用
APP_NAME=psychology-server
ENV=dev
HOST=0.0.0.0
PORT=8000

# 数据库：SQLite（第一阶段默认）
DATABASE_URL=sqlite:///./psychology.db
# 如服务器有可用 MySQL，切换为：
# DATABASE_URL=mysql+pymysql://psychology:CHANGE_ME@127.0.0.1:3306/psychology?charset=utf8mb4

# 安全
SECRET_KEY=change-me-to-a-random-string

# 日志
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 设备心跳超时（秒），超过则视为 offline
DEVICE_OFFLINE_AFTER_SECONDS=30
