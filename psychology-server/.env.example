# 应用
APP_NAME=psychology-server
ENV=dev
HOST=0.0.0.0
PORT=8000

# 数据库：SQLite（第一阶段默认）
DATABASE_URL=sqlite:///./psychology.db
# 如服务器有可用 MySQL，切换为：
# DATABASE_URL=mysql+pymysql://psychology:CHANGE_ME@127.0.0.1:3306/psychology?charset=utf8mb4

# 安全
SECRET_KEY=change-me-to-a-random-string
# 唯一 API 密钥（X-Api-Key：设备列表/会话查询/结果查询/科研导出/设备管理）；
# 生产必须改，不落库、不进日志。X-App-Key 仅为兼容别名，取值与本项相同。
QUERY_API_KEY=change-me-query-key
# 受试者脱敏标识 HMAC 盐（M7）；生产必须改
RESEARCH_SALT=change-me-research-salt

# 日志
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 科研导出文件目录（Q-6/Q-7）；导出物含派生时间，不回写数据库
EXPORT_DIR=exports

# 设备心跳超时（秒），超过则视为 offline
DEVICE_OFFLINE_AFTER_SECONDS=30

# 会话锚点不确定度（毫秒，§8.2）
ANCHOR_UNCERTAINTY_MS=5000
# 设备轮询间隔（秒），随 active-session 下发
POLL_INTERVAL_SECONDS=3
# 断网补传窗口（秒，默认 24h）
SESSION_LATE_UPLOAD_WINDOW_SECONDS=86400

